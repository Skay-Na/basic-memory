{
  "description": "Basic Memory for Codex 生命周期 Hook：从知识图谱加载上下文、记录本地事件轨迹，并在上下文压缩后提示创建检查点。",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --quiet --script \"${PLUGIN_ROOT}/hooks/session_start.py\"",
            "statusMessage": "正在加载 Basic Memory 上下文",
            "timeout": 30
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --quiet --script \"${PLUGIN_ROOT}/hooks/pre_compact.py\"",
            "statusMessage": "正在将 Codex 工作检查点写入 Basic Memory",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
